# Suggestion box webhook configuration.
# Copy this file to `.env.local` for local development and fill in real values.
# In production (Vercel), set these as Environment Variables on the project.

# The Auto webhook URL that receives forwarded suggestions.
AUTO_SUGGESTION_WEBHOOK_URL=

# Bearer token sent as `Authorization: Bearer <token>` to the webhook.
# This is a server-only secret and is never exposed to the browser.
AUTO_SUGGESTION_WEBHOOK_TOKEN=
